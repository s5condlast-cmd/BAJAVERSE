rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnerOfNew() {
      return signedIn() && request.resource.data.created_by_id == request.auth.uid;
    }

    function isOwnerOfExisting() {
      return signedIn() && resource.data.created_by_id == request.auth.uid;
    }

    // Public catalog: anyone can read, only the signed-in creator can write
    match /Product/{id} {
      allow read: if true;
      allow create: if isOwnerOfNew();
      allow update, delete: if isOwnerOfExisting();
    }

    match /Category/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /ProductVideo/{id} {
      allow read: if true;
      allow create: if isOwnerOfNew();
      allow update, delete: if isOwnerOfExisting();
    }

    match /Livestream/{id} {
      allow read: if true;
      allow create: if isOwnerOfNew();
      allow update, delete: if isOwnerOfExisting();

      // Live chat messages
      match /chat_messages/{msgId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // Users: each person can only read and write their own profile
    match /User/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Wallet: private to the owner
    match /WalletTransaction/{id} {
      allow read, update, delete: if isOwnerOfExisting();
      allow create: if isOwnerOfNew();
    }

    // Everything else is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
